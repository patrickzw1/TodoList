{
  "productName": "TodoList Installer Acceptance",
  "identifier": "app.todolist.desktop.installer-acceptance",
  "build": {
    "features": ["production"],
    "beforeDevCommand": "npm run build:sidecar -- --production && npm run dev",
    "beforeBuildCommand": "npm run build:sidecar -- --production && npm run build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "TodoList Installer Acceptance",
      "width": 1360,
      "height": 860,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true,
      "center": true
    }]
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
