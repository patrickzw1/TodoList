{
  "productName": "TodoList",
  "identifier": "app.todolist.desktop",
  "build": {
    "features": ["production"],
    "beforeDevCommand": "npm run build:sidecar -- --production && npm run dev",
    "beforeBuildCommand": "npm run build:sidecar -- --production && npm run build"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "TodoList 任务台",
      "width": 1360,
      "height": 860,
      "minWidth": 960,
      "minHeight": 640,
      "resizable": true,
      "center": true
    }]
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "targets": [
      "nsis"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzNDY5QUIyQ0Q1RTM2QTcKUldTbk5sN05zcHBHVTlWSFpPbUFIQXNBeDdxYjRZK0QzUlhIQXBQb2hjak84QUpNd2NuMGVyaEwK",
      "endpoints": [
        "https://github.com/patrickzw1/TodoList/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
